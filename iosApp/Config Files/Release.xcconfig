// Based on https://www.kodeco.com/21441177-building-your-app-using-build-configurations-and-xcconfig#toc-anchor-003

KMP_BUILD_FLAVOR = prod
KMP_FRAMEWORK_BUILD_TYPE = release
KMP_FRAMEWORK_TARGETS = device
// Static framework is used for beta (TestFlight) and release builds.
KMP_IS_STATIC = true

// Google sign-in URL scheme, from the gitignored Firebase.xcconfig
#include? "Firebase.xcconfig"
GOOGLE_REVERSED_CLIENT_ID = $(GOOGLE_REVERSED_CLIENT_ID_MAIN)
